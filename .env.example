###############################################################################
# Application
###############################################################################
APP_NAME=EliteSender
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8085
# Always store and compute in UTC; per-workspace timezones live in
# tenants.settings.timezone and are applied at render time.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database — PostgreSQL 17 (docs/README.md decision #4)
###############################################################################
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=elitesender
DB_USERNAME=elitesender
DB_PASSWORD=

###############################################################################
# Session / cache / queue — Redis 7 (docs/README.md decision #5)
###############################################################################
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave unset locally (http); MUST be true in every deployed environment.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Local (Sail): unix socket, no TCP. Railway: REDIS_SCHEME=tcp + host/port/password.
REDIS_CLIENT=phpredis
REDIS_SCHEME=unix
REDIS_SOCKET=/var/run/redis/redis.sock
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Outbound mail (transactional only — campaign mail uses per-tenant SMTP
# relays stored in smtp_accounts, never these credentials)
###############################################################################
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@elitesender.app"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Object storage — Cloudflare R2 (docs/README.md decision #7)
###############################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=elitesender-local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

###############################################################################
# Runtime
###############################################################################
OCTANE_SERVER=roadrunner
SANCTUM_STATEFUL_DOMAINS=localhost:8085
# API tokens expire after this many minutes. Blank means never — don't.
SANCTUM_TOKEN_TTL_MINUTES=43200

###############################################################################
# Trust boundary
###############################################################################
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-*. '*' trusts any
# client, which lets a caller forge its own source IP and slip past every
# IP-keyed rate limit. Narrow this the moment you know your load-balancer range.
TRUSTED_PROXIES=*

# Origins allowed to make credentialed cross-origin API calls. Defaults to
# APP_URL. The public lead-capture endpoint has its own, credential-free policy.
CORS_ALLOWED_ORIGINS="${APP_URL}"

###############################################################################
# Observability
###############################################################################
# JSON on stderr in containers so the platform can index fields rather than
# regex-scrape lines. Every record is stamped with its tenant.
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

###############################################################################
# Billing
###############################################################################
# Currency is chosen per workspace: NGN for Nigerian customers, otherwise the
# default below. Amounts everywhere are MINOR units (kobo, cents).
BILLING_DEFAULT_GATEWAY=paystack
BILLING_TRIAL_DAYS=14
# Days an unpaid invoice may stay open before sending is paused.
BILLING_GRACE_DAYS=7

# Paystack settles NGN and (where your account is enabled) USD.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Stripe is implemented but stays hidden at checkout until a key is present.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Offline bank transfer. Leave the account number blank to hide the method.
BILLING_MANUAL_ENABLED=true
BANK_NGN_NAME=
BANK_NGN_ACCOUNT_NAME=
BANK_NGN_ACCOUNT_NUMBER=
BANK_USD_NAME=
BANK_USD_ACCOUNT_NAME=
BANK_USD_ACCOUNT_NUMBER=
BANK_USD_SWIFT=
BANK_USD_IBAN=

###############################################################################
# Front end
###############################################################################
VITE_APP_NAME="${APP_NAME}"
