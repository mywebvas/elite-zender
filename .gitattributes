*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Enforce BOM-free, LF-normalised text so a Windows editor cannot reintroduce
# a UTF-8 BOM before <!DOCTYPE> or a PHP open tag.
* text=auto eol=lf
*.blade.php text eol=lf
*.php text eol=lf
