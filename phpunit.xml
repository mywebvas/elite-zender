<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         failOnNotice="true"
         failOnDeprecation="false"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutCoverageMetadata="false"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnPhpunitDeprecations="true"
>
    <!--
        executionOrder="random" is deliberate: it surfaces tests that only pass
        because an earlier test left state behind. Every suite here is
        transaction-wrapped by Tests\TestCase, so order must not matter.
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Console/Commands</directory>
        </exclude>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!--
            Security defaults are asserted, so they must come from the code and
            not from whatever a developer happens to have in .env. `force`
            makes that true even when the variable is exported in the shell.
        -->
        <env name="APP_FRAME_ANCESTORS" value="" force="true"/>
        <env name="TRUSTED_PROXIES" value="" force="true"/>
        <!--
            Payment endpoints are pinned so the suite asserts against the real
            provider hostnames whatever a developer has pointed their local
            .env at (a stub, a sandbox, a proxy). Http::fake() matches on URL,
            so an overridden base URL silently bypasses every fake.
        -->
        <env name="PAYSTACK_BASE_URL" value="https://api.paystack.co" force="true"/>
        <env name="STRIPE_BASE_URL" value="https://api.stripe.com" force="true"/>
        <!-- 4 rounds keeps the suite fast; production uses the config default. -->
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- The array session store cannot encrypt; keep it off under test. -->
        <env name="SESSION_ENCRYPT" value="false"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <!-- Never let a test reach the network for fonts or telemetry. -->
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
